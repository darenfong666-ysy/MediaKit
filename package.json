{
  "name": "mediakit",
  "version": "0.1.1",
  "description": "Local media enhancement workbench for images, video, cutout, and audio.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/darenfong666-ysy/MediaKit.git"
  },
  "type": "module",
  "main": "desktop-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "release": "electron-builder --win nsis --x64 --publish always",
    "prepare-engines": "node scripts/prepare-engines.mjs",
    "check": "node --check server.js"
  },
  "build": {
    "appId": "local.mediakit.workbench",
  "productName": "MediaKit",
  "artifactName": "MediaKit-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-main.js",
      "desktop-preload.cjs",
      "server.js",
      "assets/**/*",
      "src/**/*",
      "scripts/**/*",
      "README.md",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
      ,"!node_modules/demucs/htdemucs.onnx"
    ],
    "asarUnpack": [
      "scripts/**/*"
    ],
    "win": {
      "icon": "assets/kepler.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "darenfong666-ysy",
        "repo": "MediaKit",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@tugrul/rembg": "^1.0.3",
    "demucs": "^1.0.0",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
