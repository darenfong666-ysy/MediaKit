{
  "name": "mediakit",
  "version": "0.1.0",
  "description": "Local media enhancement workbench for images, video, cutout, and audio.",
  "private": true,
  "type": "module",
  "main": "desktop-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win portable --x64",
    "prepare-engines": "node scripts/prepare-engines.mjs",
    "check": "node --check server.js"
  },
  "build": {
    "appId": "local.mediakit.workbench",
  "productName": "MediaKit",
  "artifactName": "MediaKit-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop-main.js",
      "desktop-preload.cjs",
      "server.js",
      "assets/**/*",
      "src/**/*",
      "README.md",
      "THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "engines",
        "to": "engines",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/kepler.ico",
      "target": "portable"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@tugrul/rembg": "^1.0.3",
    "demucs": "^1.0.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
